# Environment variables for notebooklm-mcp-proxy
# Copy to .env and adjust paths for your system

# Command to start the NotebookLM MCP server (FastMCP v2)
NOTEBOOKLM_SERVER_COMMAND=/home/ubuntuvivo/.hermes/profiles/lokadata/notebooklm_mcp/.venv/bin/python

# JSON array of arguments passed to the NotebookLM server command
NOTEBOOKLM_SERVER_ARGS='["-m", "notebooklm_mcp.cli", "-c", "notebooklm-config.json", "server"]'

# Working directory for the NotebookLM server process
NOTEBOOKLM_SERVER_CWD=/home/ubuntuvivo/.hermes/profiles/lokadata/notebooklm_mcp

# Auth backend: "web" (cookie-based) or "android" (bearer token)
NOTEBOOKLM_BACKEND=web

# Headless mode for browser
NOTEBOOKLM_HEADLESS=true

# Chrome profile directory (relative to NOTEBOOKLM_SERVER_CWD or absolute)
NOTEBOOKLM_PROFILE_DIR=./chrome_profile_notebooklm
